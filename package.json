{
  "name": "gym-tv-timer",
  "version": "0.1.0",
  "private": true,
  "description": "Pure round-timer, TV-pairing and bell logic for a gym TV, extracted from ppbf-platform. No storage, auth or framework code.",
  "engines": {
    "node": "22.x"
  },
  "files": [
    "dist",
    "sounds"
  ],
  "exports": {
    "./roundTimers": {
      "types": "./dist/roundTimers.d.ts",
      "default": "./dist/roundTimers.js"
    },
    "./wallRoundTimer": {
      "types": "./dist/wallRoundTimer.d.ts",
      "default": "./dist/wallRoundTimer.js"
    },
    "./gymSayings": {
      "types": "./dist/gymSayings.d.ts",
      "default": "./dist/gymSayings.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./gymTvs": {
      "types": "./dist/gymTvs.d.ts",
      "default": "./dist/gymTvs.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "default": "./dist/security.js"
    },
    "./sounds/boxing-bell.wav": "./sounds/boxing-bell.wav",
    "./sounds/CREDITS.txt": "./sounds/CREDITS.txt",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check:dropin": "node scripts/check-dropin.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
